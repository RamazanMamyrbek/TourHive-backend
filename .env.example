# Environment configuration for TourHive Local Development

# Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_DB=tourhive_db
POSTGRES_USER=tourhive_user
POSTGRES_PASSWORD=tourhive_secret
DB_HOST=localhost
DB_PORT=5432

# Mailpit (Local SMTP)
MAIL_HOST=localhost
MAIL_SMTP_PORT=1025
MAIL_HTTP_PORT=8025

# MinIO (Local S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
